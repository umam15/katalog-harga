# Kompresi respons teks (HTML/CSS/JS/JSON) - mengurangi ukuran transfer
# tanpa mengubah apa pun di sisi PHP.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Cache aset statis di browser. Gambar via image.php sudah punya header
# cache sendiri (lihat image.php) - ini khusus untuk file statis (CSS/JS/ikon)
# yang tidak lewat PHP.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript   "access plus 7 days"
    ExpiresByType image/x-icon             "access plus 30 days"
    ExpiresByType image/png                "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# URL bersih untuk /api/v1/* -> file .php yang sesuai di folder api/v1/.
# Query string (?q=...&kantor=...) tetap diteruskan apa adanya lewat [QSA].
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/v1/items$ api/v1/items.php [QSA,L]
    RewriteRule ^api/v1/items/([^/]+)$ api/v1/item-detail.php?kodeitem=$1 [QSA,L]
</IfModule>
