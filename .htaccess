# Security header untuk semua respons (statis maupun lewat PHP, termasuk
# panel admin & /api/v1/*) - satu titik kontrol lewat Apache, bukan
# per-file PHP, supaya konsisten di semua halaman tanpa terkecuali.
# CSP sengaja masih mengizinkan 'unsafe-inline' untuk script & style:
# aplikasi ini pakai banyak onclick/onsubmit inline dan <script> inline
# (lihat index.php, admin/*) - proteksi utama di sini adalah membatasi
# SEMUA resource (script/style/gambar/font) cuma boleh dari origin sendiri,
# menutup celah eksfiltrasi/loading resource pihak ketiga meski XSS terjadi.
# Kalau nanti onclick/onsubmit inline dipindah ke file .js eksternal,
# 'unsafe-inline' bisa dicabut dari script-src untuk proteksi lebih ketat.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Kompresi respons teks (HTML/CSS/JS/JSON) - mengurangi ukuran transfer
# tanpa mengubah apa pun di sisi PHP.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Cache aset statis di browser. Gambar via image.php sudah punya header
# cache sendiri (lihat image.php) - ini khusus untuk file statis (CSS/JS/ikon)
# yang tidak lewat PHP.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript   "access plus 7 days"
    ExpiresByType image/x-icon             "access plus 30 days"
    ExpiresByType image/png                "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# URL bersih untuk /api/v1/* -> file .php yang sesuai di folder api/v1/.
# Query string (?q=...&kantor=...) tetap diteruskan apa adanya lewat [QSA].
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/v1/items$ api/v1/items.php [QSA,L]
    RewriteRule ^api/v1/items/([^/]+)$ api/v1/item-detail.php?kodeitem=$1 [QSA,L]
    RewriteRule ^api/v1/kantor$ api/v1/kantor.php [QSA,L]
    RewriteRule ^api/v1/health$ api/v1/health.php [QSA,L]
    RewriteRule ^api/v1/openapi\.json$ api/v1/openapi.php [QSA,L]
</IfModule>
