# Database & backup (data user, jangan pernah di-commit)
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
data/backups/*.sqlite
!data/backups/.gitkeep
!data/.gitkeep

# Cache favicon lokal (hasil unduhan otomatis, lihat favicon.php — jangan di-commit)
data/favicons/*
!data/favicons/.gitkeep

# Environment / konfigurasi lokal
.env
.env.*
!.env.example

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp

# Dependency (jika suatu saat pakai Composer)
vendor/
composer.lock

# Logs
auto-commit-push.log